[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="world_props"
3d_physics/layer_3="player_car"
3d_physics/layer_4="police_car"
3d_physics/layer_5="trigger"
3d_physics/layer_6="debris"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6
3d/default_gravity=9.8
3d/solver/solver_iterations=8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_environment="res://data/environment/default_environment.tres"
environment/defaults/default_clear_color=Color(0.42, 0.55, 0.68, 1)
occlusion_culling/use_occlusion_culling=false
limits/opengl/max_renderable_elements=131072
textures/default_filters/texture_mipmap_bias=-0.25
