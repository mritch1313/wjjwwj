; Engine configuration file.
; Godot 4.7.2 stable — Open World Police Chase (Android / portrait).
;
; Renderer note (see docs/CONFIGURATION.md → "Renderer choice"):
;   gl_compatibility is used as the default because the target device is a
;   low-end Android phone (Infinix HOT 40i / Unisoc T606 / Mali-G57 MC1, 720p).
;   The Compatibility (OpenGL ES 3.0) backend has the widest driver support on
;   cheap Android hardware and the lowest runtime memory footprint.
;   Switching to the Mobile (Vulkan) renderer is a one line change:
;     rendering/renderer/rendering_method="mobile"
;     rendering/renderer/rendering_method.mobile="mobile"

config_version=5

[application]

config/name="Chase: Open World"
config/description="Free roam driving in a large procedural open world with police pursuit."
config/version="1.0.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.055, 0.07, 0.09, 1)
boot_splash/show_image=false

[autoload]

Config="*res://scripts/core/config_db.gd"
Assets="*res://scripts/core/asset_library.gd"
Save="*res://scripts/core/save_manager.gd"
Settings="*res://scripts/core/settings_manager.gd"
Perf="*res://scripts/core/performance_manager.gd"
Game="*res://scripts/core/game_state.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=414
window/size/window_height_override=736
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

