static func t(key: String) -> String:
	return t_for(key, "ru")


static func t_for(key: String, language: String) -> String:
	var table: Dictionary = STRINGS.get(language, STRINGS["en"])
	if table.has(key):
		return String(table[key])
	var fallback: Dictionary = STRINGS["en"]
	if fallback.has(key):
		return String(fallback[key])
	return key


static func languages() -> PackedStringArray:
	return PackedStringArray(["ru", "en"])
